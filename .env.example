# Copy this template to .env, replace every applicable placeholder, and set permissions to 0600.
# Instance identity and centrally published image selection.
SYNC_PROJECT_NAME=wordpress-sync
SYNC_CONTAINER_NAME=wordpress-sync
SYNC_IMAGE=ghcr.io/technicull-solutions/wordpress-sync:1.0.0
SYNC_PULL_POLICY=always
SYNC_APP_NAME=WordPress SYNC
SYNC_SERVICE_ID=wordpress-sync
SYNC_BRAND_MARK=WP
SYNC_REPOSITORY_URL=https://github.com/Technicull-Solutions/wordpress-sync

# Public URL and listener. Choose any free published host port.
SYNC_BASE_URL=https://sync.example.com
SYNC_BIND_IP=127.0.0.1
SYNC_PORT=4177

# Host paths. Relative paths resolve from the Compose project directory.
SYNC_SECRETS_HOST_PATH=./secrets
SYNC_DATA_HOST_PATH=./data
SYNC_AUDIT_HOST_PATH=./audit-export
SYNC_BACKUP_HOST_PATH=./backups
WORDPRESS_THEMES_HOST_PATH=./wordpress-themes
# Generic wp-content mount for theme and plugin targets. Keep the themes mount
# above when migrating an existing installation.
WORDPRESS_CONTENT_HOST_PATH=./wordpress-content

# Optional one-time full import from a WordPress Studio backup ZIP. The archive
# directory is read-only; the full WordPress root and backup directory are writable.
SYNC_MIGRATION_ENABLED=false
SYNC_IMPORTS_HOST_PATH=./imports
WORDPRESS_SITE_HOST_PATH=./wordpress-site
SYNC_MIGRATION_NETWORK=wordpress_database
SYNC_MIGRATION_DESTINATION_URL=https://wordpress.example.com
SYNC_MIGRATION_DB_HOST=database
SYNC_MIGRATION_DB_PORT=3306
SYNC_MIGRATION_DB_NAME=wordpress
SYNC_MIGRATION_DB_USER=wordpress
SYNC_MIGRATION_DB_PASSWORD=replace-with-destination-database-password

# Match the identity that owns the WordPress themes directory for local deployment.
SYNC_UID=1000
SYNC_GID=1000

# Set in compose.proxy.yaml when the reverse proxy shares an external Docker network.
SYNC_PROXY_NETWORK=proxy

SYNC_SESSION_SECRET=replace-with-another-long-random-value
# Browser sessions expire and blur/lock the console after this many minutes.
# Set this at or below the Cloudflare Access session duration.
SYNC_SESSION_MAX_AGE_MINUTES=60
GITHUB_WEBHOOK_SECRET=replace-with-the-github-webhook-secret
GITHUB_APP_ID=replace-with-the-numeric-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=/app/secrets/github-app-private-key.pem
GITHUB_OAUTH_CLIENT_ID=replace-with-the-github-oauth-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-the-github-oauth-client-secret
SYNC_GITHUB_USERS=github-owner-login:owner,github-operator-login:operator,github-viewer-login:read-only
# SYNC_ADMIN_PASSWORD=replace-with-an-optional-owner-fallback-password
SYNC_AUDIT_EXPORT_PATH=/app/audit-export/wordpress-sync-audit.jsonl
SYNC_AUDIT_EXPORT_REQUIRED=true
# Set this only when Cloudflare Access MFA is enforced in front of the app.
# Public/reverse-proxied hosting otherwise requires GitHub OAuth.
# SYNC_CLOUDFLARE_ACCESS_ENABLED=true
# Optional local password accounts. Use username:bcrypt:hash:role.
# SYNC_LOCAL_USERS=viewer:bcrypt:$2a$12$replace-with-hash:read-only,operator:bcrypt:$2a$12$replace-with-hash:operator

# Optional deployment and security notifications.
# Leave false to use no outbound email. GitHub repository and Actions
# subscriptions can still provide GitHub-native activity notifications.
SYNC_EMAIL_NOTIFICATIONS_ENABLED=false
# Manage recipients in the app's Email Configuration dialog.
# SYNC_NOTIFY_EMAIL_RECIPIENTS is only a fallback/seed value.
# SYNC_NOTIFY_EMAIL_RECIPIENTS=ops@example.org,webmaster@example.org
# Verify the sender domain with the SMTP provider before enabling mail.
# SYNC_NOTIFY_EMAIL_FROM=WordPress SYNC <wordpress-sync@example.com>
# SYNC_SMTP_HOST=smtp.example.org
# SYNC_SMTP_PORT=587
# SYNC_SMTP_SECURE=false
# SYNC_SMTP_USER=replace-with-provider-username
# SYNC_SMTP_PASSWORD=replace-with-smtp-password
